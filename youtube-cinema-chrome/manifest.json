{
  "manifest_version": 3,
  "name": "YouTube Cinema",
  "version": "1.0",
  "description": "Cinema mode for YouTube — ad blocker and a clean, distraction-free UI.",
  "permissions": ["storage", "declarativeNetRequest"],
  "host_permissions": ["*://*.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Cinema"
  },
  "declarative_net_request": {
    "rule_resources": [{
      "id": "ytc_ads",
      "enabled": true,
      "path": "rules.json"
    }]
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
